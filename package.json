{
  "name": "netija",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --names \"web,api\" --prefix-colors \"green,cyan\" \"npm run dev --workspace=web\" \"npm run dev --workspace=api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
