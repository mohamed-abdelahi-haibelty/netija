# Copy to load-tests/.env and fill in the real value. .env is gitignored
# repo-wide (root .gitignore's `.env*` pattern) — never commit the real IP.
#
# k6 has no --env-file flag, so export this file into your shell first,
# then run k6 plain:
#   set -a; source load-tests/.env; set +a
#   k6 run load-tests/load.js

# Required. The Hetzner server's bare IP (not a hostname). Used to bypass
# Cloudflare — see README.md "Cloudflare bypass" for why a bare IP + k6's
# `hosts` option is the recommended approach over a grey-cloud DNS
# subdomain. Find it in the Hetzner Cloud Console, or on the server itself
# via `curl -4 ifconfig.me`.
TARGET_HOST=

# Optional — override only if these ever change. Must match the real
# Caddyfile domains so TLS SNI/Host still
# match a certificate Caddy actually serves.
# WEB_DOMAIN=netija.com
# API_DOMAIN=api.netija.com

# Optional — target raw HTTP requests/second for load.js (default 330, i.e.
# ~20,000 req/min, the results-day target from project-overview.md).
# TARGET_RPS=330

# Optional — see load.js / README.md "Weighting assumptions". Recalibrate
# after a short dry run by comparing the k6 summary's http_reqs rate to its
# iterations rate.
# AVG_REQUESTS_PER_ITERATION=3.3

# Optional — spike.js peak/baseline VU counts (defaults: 1500 peak, 10
# baseline).
# SPIKE_PEAK_VUS=1500
# SPIKE_BASELINE_VUS=10

# Optional — cf-compare.js VU count (default 15; kept deliberately low, see
# README.md "Cloudflare comparison scenario").
# CF_COMPARE_VUS=15
