# =============================================================================
# Netija — Local Development Environment
# =============================================================================
# Copy this file to .env and fill in values before running docker compose.
# Never commit .env to version control (it is gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml defaults)
# -----------------------------------------------------------------------------
POSTGRES_DB=netija
POSTGRES_USER=netija
# Required — no default. Use any password for local dev.
POSTGRES_PASSWORD=changeme

# Full DSN consumed by the API and worker.
DATABASE_URL=postgresql://netija:changeme@127.0.0.1:5432/netija

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Consumed by the API (cache, rate limiting, BullMQ queue).
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Meilisearch
# -----------------------------------------------------------------------------
# Host accessible from the API and worker (both run on the host in local dev).
MEILI_HOST=http://127.0.0.1:7700
# Must match the MEILI_MASTER_KEY set in docker-compose.yml.
# Use any non-empty string for local dev; use a strong random value in production.
MEILI_MASTER_KEY=dev-master-key-change-in-production

# -----------------------------------------------------------------------------
# Uploads (shared volume between api and worker)
# -----------------------------------------------------------------------------
# Absolute path to the folder where uploaded Excel files are stored.
# Defaults to the repo-root uploads/ folder for local dev when unset.
UPLOADS_DIR=

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Internal URL the Next.js server uses to call the API (server-side only).
API_URL=http://127.0.0.1:3001
# Public URL sent to the browser. Must be reachable from the user's machine.
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
# Random secret used to sign sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# The canonical URL of the auth server (the API).
BETTER_AUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Sentry (error monitoring)
# -----------------------------------------------------------------------------
# Server-side DSN for the API and Python worker.
SENTRY_DSN=
# Client-side DSN for the Next.js browser bundle.
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# PostHog (product analytics — anonymous events only, no PII)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Cloudflare (cache purge on publish)
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
