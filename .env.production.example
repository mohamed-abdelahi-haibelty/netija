# =============================================================================
# Netija — Production Environment (single Hetzner VPS, docker-compose.prod.yml)
# =============================================================================
# Copy this file to .env.production on the SERVER (never commit it) and
# fill in every value below. See DEPLOYMENT-RUNBOOK.md section 2 for how
# each secret is generated and which values come from external accounts.
#
# Every service container in docker-compose.prod.yml addresses the others
# by Docker Compose service name (postgres, redis, meilisearch, api, web),
# never 127.0.0.1 — that's the main difference from the local .env.example.
# =============================================================================

# Deployment environment tag. Used by Sentry's `environment` field (api,
# web-server, worker) and by api/scripts/seed.ts's/verify-seed.ts's
# production guard (refuses to run the dev fake-data seeder here). Not a
# secret.
APP_ENV=production

# -----------------------------------------------------------------------------
# PostgreSQL — source of truth (attempts, imports, rejects, column_aliases,
# Better Auth tables). Not published on any host port; only reachable from
# other containers as `postgres:5432`.
# -----------------------------------------------------------------------------
POSTGRES_DB=netija
POSTGRES_USER=netija
# SECRET. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Full DSN the api and queue-worker containers use (worker/worker.py reads
# this directly too, in the same container). Must match POSTGRES_* above
# and use the service name `postgres`, not localhost.
# SECRET (embeds POSTGRES_PASSWORD).
DATABASE_URL=postgresql://netija:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/netija

# -----------------------------------------------------------------------------
# Redis — result/exam-number cache, rate limiting, BullMQ import queue.
# Not published on any host port. --requirepass is set on the redis
# service's `command:` in docker-compose.prod.yml from REDIS_PASSWORD
# below — no application code change needed, ioredis and BullMQ both parse
# credentials straight out of REDIS_URL.
# -----------------------------------------------------------------------------
# SECRET. Generate: openssl rand -hex 24
REDIS_PASSWORD=
# SECRET (embeds REDIS_PASSWORD).
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379

# -----------------------------------------------------------------------------
# Meilisearch — name-search index. Not published on any host port.
# -----------------------------------------------------------------------------
# SECRET. Generate: openssl rand -hex 32
MEILI_MASTER_KEY=
MEILI_HOST=http://meilisearch:7700

# -----------------------------------------------------------------------------
# Uploads (shared volume between the api and queue-worker containers — both
# run from the same image, see api/Dockerfile). MUST be an absolute path in
# production: unlike local dev, the container's cwd is /app, not api/, so
# the code's own relative default (`../uploads`) would resolve outside the
# app entirely. docker-compose.prod.yml bind-mounts ./uploads (repo root)
# to this exact path so files survive container rebuilds and are easy to
# include in your own backups.
# -----------------------------------------------------------------------------
UPLOADS_DIR=/app/uploads

# -----------------------------------------------------------------------------
# Worker invocation — the api process spawns worker/*.py as a subprocess
# in the SAME container (api/Dockerfile installs Python into a venv).
# -----------------------------------------------------------------------------
PYTHON_BIN=/opt/venv/bin/python3
WORKER_DIR=/app/worker

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Internal URL the Next.js SERVER uses to call the api — goes container to
# container over the Docker network, never through Caddy/Cloudflare, so
# admin-page data fetches don't pay the extra network hop.
API_URL=http://api:3001
# Public URL the BROWSER calls — must be the real internet-facing api
# domain (only NEXT_PUBLIC_* vars reach the browser, architecture.md
# invariant 4). Baked into the web image at BUILD time (see web/Dockerfile
# and the runbook's "new env var" note) — changing this needs a rebuild,
# not just a restart.
NEXT_PUBLIC_API_URL=https://api.example.com
# Origin of the web app, used by the api for CORS (api/src/app.ts) and as
# one of Better Auth's trustedOrigins (api/src/lib/auth.ts).
WEB_URL=https://example.com

# -----------------------------------------------------------------------------
# Better Auth (admin session cookies)
# -----------------------------------------------------------------------------
# SECRET — signs session tokens; rotating it logs out every admin session.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Canonical URL of the auth server = the api's public origin.
BETTER_AUTH_URL=https://api.example.com

# -----------------------------------------------------------------------------
# Sentry (error monitoring) — EXTERNAL ACCOUNT (sentry.io project required)
# -----------------------------------------------------------------------------
# Server-side DSN (api, web server/edge runtime, Python worker). SECRET-ish:
# not a credential that grants access, but treat as sensitive — don't post
# it publicly.
SENTRY_DSN=
# Client-side DSN for the browser bundle. Same project, safe to expose to
# the browser (that's what NEXT_PUBLIC_* is for) — Sentry DSNs are
# write-only tokens.
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# PostHog (product analytics) — EXTERNAL ACCOUNT (posthog.com EU project)
# Browser-only, anonymous-only (see project-overview.md Analytics section).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Cloudflare (cache purge on publish/unpublish) — EXTERNAL ACCOUNT
# api/src/lib/cloudflare.ts silently no-ops if either is unset, so a
# publish still works without these, it just won't purge the edge cache
# (relies on the short Cache-Control TTLs instead until purged manually).
# -----------------------------------------------------------------------------
# SECRET. Cloudflare dashboard → My Profile → API Tokens → Create Token →
# "Edit zone DNS" template is too broad; instead use a custom token scoped
# to Zone → Cache Purge → Purge, restricted to this one zone.
CLOUDFLARE_API_TOKEN=
# Not a secret by itself, but keep private. Cloudflare dashboard → your
# domain → Overview (right sidebar) → Zone ID.
CLOUDFLARE_ZONE_ID=

# -----------------------------------------------------------------------------
# NOT stored here: ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_NAME
# -----------------------------------------------------------------------------
# These are consumed once by `npm run auth:create-admin --workspace=api`
# (api/scripts/create-admin.ts) to provision the first admin login. Pass
# them as one-off `-e` flags on that single command (see the runbook's
# "seeding the admin account" step) instead of leaving a real admin
# password sitting in this file indefinitely.
