{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && npm run db:check-journal",
    "db:migrate": "drizzle-kit migrate",
    "db:check-journal": "tsx scripts/check-migration-journal.ts",
    "db:fix-journal": "tsx --env-file=../.env scripts/check-migration-journal.ts --fix",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify-seed": "tsx scripts/verify-seed.ts",
    "search:reindex": "tsx scripts/build-search-index.ts",
    "auth:create-admin": "tsx --env-file=../.env scripts/create-admin.ts",
    "queue:worker": "tsx watch --env-file=../.env src/queueWorker.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hono/zod-validator": "^0.8.0",
    "@sentry/node": "^10.63.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.79.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.12.26",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.58.0",
    "pg": "^8.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.13",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vitest": "^3.2.3"
  }
}
